# Server binding
HOST=127.0.0.1
PORT=3000

# Company Evidence and SoCLaaS. This key is required to start the live agent.
DATABASE_URL=postgresql://orgforge:orgforge-local@localhost:5432/orgforge
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_COMPANY_MODEL=qwen3.8:27b

# User-scoped Personal Memory. The local App Server uses these defaults.
LETTA_APP_SERVER_URL=http://127.0.0.1:4500
LETTA_APP_SERVER_TOKEN=
LETTA_MODEL=
LETTA_APP_SERVER_TIMEOUT_MS=180000

# Hybrid retrieval through Amazon Bedrock. Authenticate separately with
# `aws login --profile sme-agent`; never put AWS access keys in this file.
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=ap-southeast-2
BEDROCK_EMBEDDING_BUDGET_USD=5
AWS_PROFILE=sme-agent

LM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: use only for UI work without a running Letta App Server.
MEMORY_ADAPTER=letta

# Emergent memory (orgforge_kb/cognee_memory.py). Any OpenAI-compatible chat
# endpoint works; LiteLLM routes on the `openai/` prefix, so keep it.
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=openai/deepseek-v4-pro
LLM_API_KEY=

# Extraction needs an embedder as well as a chat model, and DeepSeek serves no
# /embeddings endpoint, so embed locally. fastembed ships with cognee and
# downloads this 67 MB model on first use. Dimensions must match the model.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
