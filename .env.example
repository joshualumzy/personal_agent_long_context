# The browser never receives these values.
LETTA_APP_SERVER_URL=http://127.0.0.1:4500
# LETTA_APP_SERVER_TOKEN=
# LETTA_MODEL=openai/gpt-5-mini
# LETTA_APP_SERVER_TIMEOUT_MS=180000

HOST=127.0.0.1
PORT=3000

# Use only for UI work without a running App Server.
# MEMORY_ADAPTER=deterministic

# Model credentials for the Memora evaluation harness and for the recruiting
# direction (S3). The memory agent itself reaches its model through Letta.
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_API_KEY=

# Recruiting (S3). Needs the SOCLAAS_* values above; the rest unlock real services.
# RECRUITING_MODEL=qwen3.8:27b
# People search. Without it the app serves invented sample profiles.
EXA_API_KEY=
# Email lookup, tried in this order. Without both, no email is found; nothing is guessed.
HUNTER_API_KEY=
PROSPEO_API_KEY=
# Gmail sending and reply reading (OAuth client of type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI on the OAuth client exactly. Defaults to port $PORT.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/recruiting/gmail/callback
# FOUNDER_NAME=
# COMPANY_NAME=
# RECRUITING_PREFERENCE_THRESHOLD=2
