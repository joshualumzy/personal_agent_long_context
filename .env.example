# The browser never receives these values.
LETTA_APP_SERVER_URL=http://127.0.0.1:4500
# LETTA_APP_SERVER_TOKEN=
# LETTA_MODEL=openai/gpt-5-mini
# LETTA_APP_SERVER_TIMEOUT_MS=180000

HOST=127.0.0.1
PORT=3000

# SME employee context workflow. The browser never receives these values.
DATABASE_URL=postgresql://orgforge:orgforge-local@127.0.0.1:5432/orgforge
# SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# Used by the SME employee-context workflow. The evaluation grader has its own
# MEMORA_JUDGE_MODEL setting.
SOCLAAS_COMPANY_MODEL=qwen3.8:27b

# Hosted semantic retrieval through Amazon Bedrock. Use the default AWS credential chain locally.
AWS_REGION=ap-southeast-2
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# The backfill refuses to start if its estimated input cost exceeds this cap.
BEDROCK_EMBEDDING_BUDGET_USD=5

# Use only for UI work without a running App Server.
# MEMORY_ADAPTER=deterministic

# The optional Memora evaluation harness reuses the SoCLaaS gateway credentials
# above and selects its grader with MEMORA_JUDGE_MODEL.
