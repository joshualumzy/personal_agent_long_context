# Server binding
HOST=127.0.0.1
PORT=3000

# Company Evidence and SoCLaaS. This key is required to start the live agent.
DATABASE_URL=postgresql://orgforge:orgforge-local@localhost:5432/orgforge
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_COMPANY_MODEL=qwen3.8:27b

# User-scoped Personal Memory. The local App Server uses these defaults.
LETTA_APP_SERVER_URL=http://127.0.0.1:4500
LETTA_APP_SERVER_TOKEN=
LETTA_MODEL=
LETTA_APP_SERVER_TIMEOUT_MS=180000

# Hybrid retrieval through Amazon Bedrock. Authenticate separately with
# `aws login --profile sme-agent`; never put AWS access keys in this file.
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=ap-southeast-2
BEDROCK_EMBEDDING_BUDGET_USD=5
AWS_PROFILE=sme-agent

# Optional: use only for UI work without a running Letta App Server.
MEMORY_ADAPTER=letta

# Recruiting (S3), served under /recruiting. Uses the SOCLAAS_* values above;
# the rest unlock real services.
# RECRUITING_MODEL=qwen3.8:27b
# People search. Without it the app serves invented sample profiles.
EXA_API_KEY=
# Email lookup, tried in this order. Without both, no email is found; nothing is guessed.
HUNTER_API_KEY=
PROSPEO_API_KEY=
# Gmail sending and reply reading (OAuth client of type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI on the OAuth client exactly. Defaults to port $PORT.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/recruiting/gmail/callback
# FOUNDER_NAME=
# COMPANY_NAME=
# One sentence on what you build. Without it, outreach says nothing about the company.
# COMPANY_PITCH=
# RECRUITING_PREFERENCE_THRESHOLD=2

# Meeting actions (S2), served under /meetings. Uses the SOCLAAS_* values above,
# and the Gmail connection and recruiting agent above when they are configured.
# MEETINGS_MODEL=qwen3.8:27b
# GitHub repo ("owner/name") that approved tickets open a prefilled new-issue page in; unset, tickets stay simulated.
# MEETINGS_TICKET_REPO=
# Where approved calendar invites, emails (when Gmail is not connected), and new documents open: google or microsoft.
# MEETINGS_SUITE=google
# Where approved chat messages open: whatsapp or teams (teams needs the recipient's work email, else WhatsApp).
# MEETINGS_CHAT=whatsapp
