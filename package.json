{
  "name": "personal-context-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:smoke": "RUN_REAL_LETTA=1 node --env-file=.env --import tsx --test test/letta.smoke.test.ts",
    "letta:server": "letta server --backend local --listen ws://127.0.0.1:4500",
    "test:browser": "node --import tsx --test test/browser.test.ts",
    "demo:scenario": "node --env-file=.env --import tsx scripts/demo-scenario.ts",
    "eval:memora": "node --env-file=.env --import tsx eval/memora/run.ts",
    "eval:memora:report": "node --env-file=.env --import tsx eval/memora/report.ts",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "orgforge:ingest": "set -a; . ./.env; set +a; HF_HOME=tmp/orgforge/hf-cache .venv/bin/python scripts/orgforge/ingest.py",
    "test:orgforge": ".venv/bin/python scripts/orgforge/test_ingest.py",
    "orgforge:embed": "node --env-file=.env --import tsx scripts/orgforge/embed.ts",
    "linkedin:login": "node --env-file-if-exists=.env --import tsx scripts/linkedin-inbox.ts --login",
    "linkedin:sync": "node --env-file-if-exists=.env --import tsx scripts/linkedin-inbox.ts",
    "eval:recruiting:template": "node --import tsx eval/recruiting/run.ts --template",
    "eval:recruiting": "node --env-file=.env --import tsx eval/recruiting/run.ts",
    "eval:meetings": "node --env-file=.env --import tsx eval/meetings/run.ts src/meetings/eval-factory.ts",
    "eval:meetings:dry": "node --import tsx eval/meetings/run.ts --dry",
    "google:check": "node --env-file=.env --import tsx scripts/google-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1139.0",
    "@letta-ai/letta-agent-sdk": "0.8.12",
    "dompurify": "^3.3.0",
    "fastify": "5.12.5",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "pg": "8.16.3",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "jsdom": "27.0.0",
    "playwright": "^1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "@letta-ai/letta-code@0.32.13": true,
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true
  }
}
